# Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key

# Database
# Development (SQLite) - default, no changes needed
DATABASE_URL=sqlite:///greenharvest.db

# Production (PostgreSQL) - uncomment and fill in for production
# DATABASE_URL=postgresql://username:password@hostname:5432/greenharvest

# CORS
FRONTEND_ORIGIN=http://localhost:3000
